resource app_signature "application/x-vnd.NFSMount";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 1,

	variety = B_APPV_BETA,
	internal = 1,

	short_info = "NFSMount",
	long_info = "NFS Share Manager for Haiku"
};

resource(1, "BEOS:FILE_TYPES") message {
	"types" = "application/x-vnd.NFSMount"
};

/*
 * Application icon (HVIF format).
 *
 * Design source of truth: resources/NFSMount-icon.svg — a NAS box with
 * status LEDs, a shared folder with a people glyph, and a network tee.
 * Regenerate the .hvif from the SVG with hvif-tools (icon2icon):
 *
 *   icon2icon resources/NFSMount-icon.svg resources/NFSMount.hvif
 *
 * (github.com/threedeyes/hvif-tools; verify by rendering back to PNG
 * at 64/32/16 px.) Icon-O-Matic can also open the .hvif directly for
 * LOD-hint tweaks.
 */
resource(101, "BEOS:ICON") #'VICN' import "../resources/NFSMount.hvif";
